APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/bharatvideo
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/storage
PUBLIC_ASSET_BASE_URL=http://localhost:8000/assets
CORS_ORIGINS=http://localhost:3000
ENGINE_MODE=bridge
# Host path is used only by Docker to mount your existing repo read-only.
HOST_AGENTIC_CONTENT_FACTORY_ROOT=/Users/maa/agentic-content-factory
# Container-visible path used by the API/worker adapter.
AGENTIC_CONTENT_FACTORY_ROOT=/workspace/agentic-content-factory

LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_MODEL=llama3.2

LLM_TIMEOUT_SECONDS=120

LLM_TEMPERATURE=0.7

LLM_FALLBACK_TO_MOCK=true

ENGINE_BRIDGE_URL=http://host.docker.internal:8090

ENGINE_BRIDGE_TOKEN=change-me-local-dev-token

TTS_PROVIDER=host_say

TTS_VOICE=Lekha

TTS_SPEECH_RATE=185

IMAGE_PROVIDER=mock

FFMPEG_BINARY=ffmpeg

FFPROBE_BINARY=ffprobe

RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_EXPECTED_ACCOUNT_ID=
