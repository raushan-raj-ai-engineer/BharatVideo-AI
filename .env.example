APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/bharatvideo
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=/data/storage
PUBLIC_ASSET_BASE_URL=http://localhost:8000/assets
CORS_ORIGINS=http://localhost:3000

# v0.2 real local LLM planning. Docker reaches macOS Ollama through host.docker.internal.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.7
LLM_FALLBACK_TO_MOCK=true

# Existing render engine remains a separate repo and runs on the Mac host.
ENGINE_MODE=bridge
ENGINE_BRIDGE_URL=http://host.docker.internal:8090
ENGINE_BRIDGE_TOKEN=change-me-local-dev-token
HOST_AGENTIC_CONTENT_FACTORY_ROOT=/Users/maa/agentic-content-factory
AGENTIC_CONTENT_FACTORY_ROOT=/workspace/agentic-content-factory

# v0.3 media pipeline (local/free defaults)
TTS_PROVIDER=host_say
TTS_VOICE=Lekha
TTS_SPEECH_RATE=185
IMAGE_PROVIDER=mock
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# v0.7 auth + pricing. Replace AUTH_SECRET before any public deployment.
AUTH_SECRET=dev-change-this-auth-secret
AUTH_TOKEN_HOURS=168
SIGNUP_CREDITS=30

# Safe default: mock checkout adds test credits and never charges real money.
# Set BILLING_MODE=razorpay and use TEST keys first for Razorpay Checkout.
BILLING_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# V0.8 production payment hardening.
# Create a separate webhook secret in Razorpay Dashboard. Do NOT reuse KEY_SECRET.
RAZORPAY_WEBHOOK_SECRET=
# Optional extra guard if you want to pin webhooks to one Razorpay account id (acc_...).
RAZORPAY_EXPECTED_ACCOUNT_ID=

cd ~/Downloads/bharatvideo_ai_mvp_v0_1

docker compose exec \
  -e BILLING_MODE=mock \
  -e RAZORPAY_EXPECTED_ACCOUNT_ID= \
  -e REDIS_URL=redis://redis:6379/15 \
  -e CELERY_BROKER_URL=redis://redis:6379/15 \
  -e CELERY_RESULT_BACKEND=redis://redis:6379/15 \
  api sh -lc \
  'python -m pytest -q --ignore=tests/test_bridge_duration_autofit.py'